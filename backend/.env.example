# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=queueless
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/queueless

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=queueless_super_secret_access_token_key_change_in_production_123456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=queueless_super_secret_refresh_token_key_change_in_production_789012
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Email Notifications
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="QueueLess Alerts" <no-reply@queueless.local>
