{
  "name": "queueless-backend",
  "version": "1.0.0",
  "description": "Smart appointment booking and live virtual queue backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrator.ts up",
    "migrate:down": "tsx src/db/migrator.ts down",
    "seed": "tsx src/db/seed.ts",
    "demo:double-booking": "tsx scripts/double-booking-demo.ts",
    "demo:socket": "tsx scripts/socket-demo.ts",
    "demo:notifications": "tsx scripts/notification-demo.ts",
    "demo:outage": "tsx scripts/outage-demo.ts",
    "seed:analytics": "tsx scripts/seed-analytics.ts",
    "docs:export": "tsx scripts/export-openapi.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@queueless/contracts": "*",
    "@queueless/common": "*",
    "@queueless/messaging": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/amqplib": "^0.10.8",
    "amqplib": "^2.4.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.13.8",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
