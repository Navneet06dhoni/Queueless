# Note: Sticky sessions (ip_hash) will return via an upstream load-balancing pool when queue-service scales to multiple instances.

# Rate limiting zones with configurable rates (preserving default rates: 5r/m and 20r/s)
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=${GATEWAY_AUTH_RATE_LIMIT};
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=${GATEWAY_API_RATE_LIMIT};
limit_req_status 429;

server {
    listen 8080;
    server_name _;

    # Dynamic DNS resolution using Docker's internal DNS (127.0.0.11) with 5s TTL and 500ms timeout
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 500ms;

    # Upstream targets as variables to enforce dynamic DNS re-resolution across container recreations
    set $core http://${BACKEND_UPSTREAM};
    set $notification http://${NOTIFICATION_UPSTREAM};
    set $queue http://${QUEUE_UPSTREAM};
    set $frontend http://${FRONTEND_UPSTREAM};

    # Default proxy timeouts for fast failure on dead upstreams (<1000ms)
    proxy_connect_timeout 500ms;
    proxy_read_timeout 5s;
    proxy_send_timeout 5s;
    proxy_next_upstream_tries 1;

    # Header safety & trust boundary (strip sensitive/spoofed headers)
    proxy_set_header X-User-Id "";
    proxy_set_header X-User-Role "";
    proxy_set_header X-User-Name "";
    proxy_set_header X-User-Email "";
    proxy_set_header X-Internal-Auth "";
    proxy_set_header X-Internal-Role "";
    proxy_set_header X-Internal-Secret "";
    proxy_set_header X-Internal-UserId "";
    proxy_set_header X-Internal-Token "";

    # Forwarded standard headers
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Request-Id $gateway_request_id;

    # Always return X-Request-Id on every response (hiding upstream duplicate)
    proxy_hide_header X-Request-Id;
    add_header X-Request-Id $gateway_request_id always;

    # Custom Error Pages returning JSON bodies matching REST format
    error_page 401 /error_401;
    error_page 403 /error_403;
    error_page 413 /error_413;
    error_page 429 /error_429;
    error_page 500 502 503 504 =502 /error_502;

    location = /error_401 {
        internal;
        default_type application/json;
        return 401 '{"error":{"code":"UNAUTHORIZED","message":"Authentication required","requestId":"$gateway_request_id"}}';
    }

    location = /error_403 {
        internal;
        default_type application/json;
        return 403 '{"error":{"code":"USER_BLOCKED","message":"Your account has been suspended","requestId":"$gateway_request_id"}}';
    }

    location = /error_413 {
        internal;
        default_type application/json;
        return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"Request entity too large","requestId":"$gateway_request_id"}}';
    }

    location = /error_429 {
        internal;
        default_type application/json;
        add_header Retry-After 12 always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"Too many requests, please try again later","requestId":"$gateway_request_id"}}';
    }

    location = /error_502 {
        internal;
        default_type application/json;
        return 502 '{"error":{"code":"UPSTREAM_UNAVAILABLE","message":"Bad gateway or upstream service unavailable","requestId":"$gateway_request_id"}}';
    }

    location = /error_503 {
        internal;
        default_type application/json;
        return 503 '{"error":{"code":"UPSTREAM_UNAVAILABLE","message":"Service temporarily unavailable","requestId":"$gateway_request_id"}}';
    }

    location = /error_504 {
        internal;
        default_type application/json;
        return 504 '{"error":{"code":"UPSTREAM_TIMEOUT","message":"Gateway timeout","requestId":"$gateway_request_id"}}';
    }

    # (1) Health check served directly by Nginx
    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # (2) Internal auth verification endpoint (used ONLY by auth_request)
    location = /internal/auth-verify {
        internal;
        proxy_pass $core/api/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Request-Id $gateway_request_id;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
        proxy_set_header X-User-Name "";
        proxy_set_header X-User-Email "";
        proxy_connect_timeout 500ms;
        proxy_read_timeout 2s;
    }

    # Block all other /internal/ routes from external clients
    location ^~ /internal/ {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Resource not found","requestId":"$gateway_request_id"}}';
    }

    # (3) Rate-limited auth routes (edge limit: 5 req/min, burst 2, nodelay)
    location = /api/auth/login {
        limit_req zone=auth_limit burst=${GATEWAY_AUTH_BURST} nodelay;
        proxy_pass $core$request_uri;
        proxy_connect_timeout 500ms;
        proxy_read_timeout 5s;
    }

    location = /api/auth/register {
        limit_req zone=auth_limit burst=${GATEWAY_AUTH_BURST} nodelay;
        proxy_pass $core$request_uri;
        proxy_connect_timeout 500ms;
        proxy_read_timeout 5s;
    }

    # (4) Canary auth_request verification on /api/auth/me
    location = /api/auth/me {
        auth_request /internal/auth-verify;
        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_name $upstream_http_x_user_name;
        auth_request_set $auth_user_email $upstream_http_x_user_email;

        proxy_pass $core$request_uri;
        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Name $auth_user_name;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $gateway_request_id;
        proxy_connect_timeout 500ms;
        proxy_read_timeout 5s;
    }

    # (5) Notification Service Routing with auth_request
    location /api/notifications {
        limit_req zone=api_limit burst=${GATEWAY_API_BURST} nodelay;
        auth_request /internal/auth-verify;
        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_name $upstream_http_x_user_name;
        auth_request_set $auth_user_email $upstream_http_x_user_email;

        proxy_pass $notification$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $gateway_request_id;
        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Name $auth_user_name;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
        proxy_connect_timeout 500ms;
        proxy_read_timeout 5s;
    }

    location = /api/admin/notifications {
        limit_req zone=api_limit burst=${GATEWAY_API_BURST} nodelay;
        auth_request /internal/auth-verify;
        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_name $upstream_http_x_user_name;
        auth_request_set $auth_user_email $upstream_http_x_user_email;

        proxy_pass $notification$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $gateway_request_id;
        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Name $auth_user_name;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
        proxy_connect_timeout 500ms;
        proxy_read_timeout 5s;
    }

    # (6) Public queue status route (anonymous, no auth_request)
    location ~* ^/api/queue/([a-f0-9\-]+)/status$ {
        limit_req zone=api_limit burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $queue$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $gateway_request_id;
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
        proxy_set_header X-User-Name "";
        proxy_set_header X-User-Email "";
        proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
        proxy_connect_timeout 500ms;
        proxy_read_timeout 10s;
    }

    # (7) Queue service authenticated routes with auth_request
    location /api/queue/ {
        limit_req zone=api_limit burst=${GATEWAY_API_BURST} nodelay;
        auth_request /internal/auth-verify;
        auth_request_set $auth_user_id $upstream_http_x_user_id;
        auth_request_set $auth_user_role $upstream_http_x_user_role;
        auth_request_set $auth_user_name $upstream_http_x_user_name;
        auth_request_set $auth_user_email $upstream_http_x_user_email;

        proxy_pass $queue$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $gateway_request_id;
        proxy_set_header X-User-Id $auth_user_id;
        proxy_set_header X-User-Role $auth_user_role;
        proxy_set_header X-User-Name $auth_user_name;
        proxy_set_header X-User-Email $auth_user_email;
        proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
        proxy_connect_timeout 500ms;
        proxy_read_timeout 10s;
    }

    # (8) WebSocket proxying for Socket.io routed to queue_service
    location /socket.io/ {
        proxy_pass $queue$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-Id $gateway_request_id;
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
        proxy_set_header X-User-Name "";
        proxy_set_header X-User-Email "";
        proxy_set_header X-Internal-Token "${INTERNAL_TOKEN}";
        proxy_connect_timeout 500ms;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # (9) General API proxy with rate limiting (20 req/s, burst 10, nodelay)
    location /api/ {
        limit_req zone=api_limit burst=${GATEWAY_API_BURST} nodelay;
        proxy_pass $core$request_uri;
        proxy_connect_timeout 500ms;
        proxy_read_timeout 10s;
    }

    # Default frontend SPA proxying
    location / {
        proxy_pass $frontend$request_uri;
        proxy_connect_timeout 500ms;
        proxy_read_timeout 10s;
    }
}
