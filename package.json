{
  "name": "queueless",
  "version": "1.0.0",
  "private": true,
  "description": "Smart appointment booking and live virtual queue platform for small clinics, salons and local businesses",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "docs:export": "npm --prefix backend run docs:export",
    "gen:env": "tsx scripts/generate-env.ts",
    "migrate": "npm --prefix backend run migrate",
    "migrate:down": "npm --prefix backend run migrate:down",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend run test",
    "db:create-service-dbs": "tsx scripts/create-service-dbs.ts",
    "migrate:notification": "npm --prefix services/notification-service run migrate",
    "migrate:queue": "npm --prefix services/queue-service run migrate",
    "copy:notifications": "tsx scripts/copy-notifications.ts",
    "copy:queue": "tsx scripts/copy-queue.ts",
    "up:services": "docker compose up -d notification-service queue-service gateway",
    "down:services": "docker compose stop notification-service queue-service",
    "e2e:notification": "tsx scripts/e2e-notification.ts",
    "e2e:queue": "tsx scripts/e2e-queue.ts",
    "demo:notification-outage": "tsx scripts/demo-notification-outage.ts",
    "demo:queue-outage": "tsx scripts/demo-queue-outage.ts",
    "gateway:lint": "docker compose exec -T gateway nginx -t",
    "test:gateway": "tsx scripts/gateway-smoke.ts",
    "check:secrets": "node scripts/check-secrets.js",
    "test:services": "npm --prefix services/notification-service test && npm --prefix services/queue-service test",
    "verify": "npm --prefix backend run docs:export && npm --prefix packages/contracts test && npm --prefix packages/common test && npm --prefix packages/messaging test && npm --prefix services/notification-service test && npm --prefix services/queue-service test && npm --prefix backend test && npm run gateway:lint && npm --prefix frontend run lint && npm --prefix frontend test && npm --prefix backend run build && npm --prefix frontend run build"
  },
  "keywords": [
    "appointment-booking",
    "virtual-queue",
    "redis",
    "postgres",
    "express",
    "react"
  ],
  "author": "QueueLess Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
