NODE_ENV=development
PORT=3004
INTERNAL_TOKEN=queueless-internal-gateway-secret-key-32ch

# Database
DATABASE_URL=postgresql://notification_user:notification_password@localhost:5432/notification_db
TEST_DATABASE_URL=postgresql://notification_user:notification_password@localhost:5432/notification_test

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="QueueLess Alerts" <no-reply@queueless.local>
NOTIFICATIONS_ENABLED=true
EMAIL_RETRY_DELAYS_MS=1000,4000,16000
BUSINESS_TIMEZONE=Asia/Kolkata
