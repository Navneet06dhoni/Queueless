NODE_ENV=development
PORT=3003
INTERNAL_TOKEN=CHANGE_ME
CORE_SERVICE_URL=http://localhost:5000

# Database (Logical queue_db, queue_user role)
DATABASE_URL=postgresql://queue_user:CHANGE_ME@localhost:5432/queue_db

# Redis (Logical DB 2 in production/dev, DB 3 in tests)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Queue Settings
DEFAULT_SERVICE_MINUTES=10
QUEUE_NOTIFY_POSITION=3
CHECKIN_EARLY_MINUTES=30
CHECKIN_GRACE_MINUTES=15
BUSINESS_TIMEZONE=Asia/Kolkata
